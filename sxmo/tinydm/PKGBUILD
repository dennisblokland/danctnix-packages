# Maintainer: Aren <aren@peacevolution.org>

pkgname=tinydm
pkgver=1.3.1
pkgrel=1
pkgdesc="Tiny wayland / x11 session starter for single user machines"
arch=('x86_64' 'armv7h' 'aarch64')
url="https://gitlab.nura.eco/nura/tinydm"
license=('GPL3')
depends=('xorg-xinit')
makedepends=('git')
source=("git+$url#tag=$pkgver")
sha512sums=('fd9a7a19931cb886cddc78e8550ff1af27a6eef36f909adb5966023e6fc114706e33b4f4df710360a70d812d6beceaf6c02773c1012e964709052d2b2c8158b0')

prepare() {
  cd "$pkgname"

  # Remove logging setup, so logs go to stdout (and therefore the journal)
  sed -i 's@\(setup_log\)$@# \1@g' tinydm-run-session.sh
}

package() {
  cd "$pkgname"

  make DESTDIR="$pkgdir" OPENRC=0 install
}
