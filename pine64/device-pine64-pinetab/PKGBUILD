# Maintainer: Danct12 <danct12@disroot.org>
pkgname=device-pine64-pinetab
pkgver=0.2
pkgrel=6
pkgdesc="PineTab device package"
arch=(aarch64)
url="https://github.com/dreemurrs-embedded/Pine64-Arch"
license=('MIT')
depends=(danctnix-tweaks
	linux-megi
	uboot-pinephone
	linux-firmware-realtek
	ov5640-firmware
	alsa-ucm-pinetab)
makedepends=(uboot-tools)
backup=(boot/user.scr
	etc/megapixels/config/pine64,pinetab-early-adopter.conf)
source=(pinetab-suspend-hook.sh
	phoc.ini
	machine-info
	pulseaudio-pinetweaks.conf
	gsk-renderer-gl.sh
	blacklist-rtw8723cs.conf
	user.txt
	megapixels-pinetab.conf
	8723cs-sleep.sh)

build() {
	mkimage -A arm -O linux -T script -C none -n "PineTab user script" -d "$srcdir"/user.txt "$srcdir"/user.scr
}

package() {
	# Current workaround for suspend
	install -Dm755 "$srcdir"/pinetab-suspend-hook.sh "$pkgdir"/usr/lib/systemd/system-sleep/pinetab-suspend-hook.sh

	# 1x scaling for Phosh
	install -Dm644 "$srcdir"/phoc.ini "$pkgdir"/etc/phosh/phoc.ini

	install -Dm644 "$srcdir"/machine-info "$pkgdir"/etc/machine-info

	install -Dm644 "$srcdir"/pulseaudio-pinetweaks.conf "$pkgdir"/etc/pulse/daemon.conf.d/pinetweaks.conf

	install -Dm755 "$srcdir"/gsk-renderer-gl.sh -t "$pkgdir"/etc/profile.d/

	# rtw88_8723cs fails 802.11 authentication on the PineTab; use 8723cs
	install -Dm644 -t "$pkgdir"/etc/modprobe.d "$srcdir"/blacklist-rtw8723cs.conf

	# 8723cs does not bring the SDIO card back after deep suspend; reload it around sleep
	install -Dm755 "$srcdir"/8723cs-sleep.sh "$pkgdir"/usr/lib/systemd/system-sleep/50-8723cs.sh

	# Load the Early Adopter DTB (K101-IM2BYL02 panel), see user.txt
	install -Dm644 "$srcdir"/user.scr "$pkgdir"/boot/user.scr

	# Camera config for Megapixels, see megapixels-pinetab.conf
	install -Dm644 "$srcdir"/megapixels-pinetab.conf \
		"$pkgdir"/etc/megapixels/config/pine64,pinetab-early-adopter.conf
	ln -s pine64,pinetab-early-adopter.conf "$pkgdir"/etc/megapixels/config/pine64,pinetab.conf
}

md5sums=('b0912b95d7d810a0f161d9bd79fc162b'
         'ecd8742a921d805e6756abc522da1dba'
         '340993065eb26f928700733369be2d9b'
         '1504e684e5a2aec439e0674cdfc9d3c1'
         'df623da01912f5ce89c178639fc22656'
         '67b01e6304228725c3a971065feaa7ce'
         '226f37f0b952614b6928864c8bf7898e'
         'b9d3309b05793bc35528c45d8e3e0492'
         'a5e0eb2e785583b9e80bd1e9df837ca7')
